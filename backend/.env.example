# =============================================================
# Backend — Conferência Mulheres Plenas 2026
# Copie para .env e preencha. NUNCA faça commit do .env.
# Tudo que estiver vazio cai num modo de desenvolvimento seguro
# (pagamento simulado, pedidos em memória, e-mail só no console).
# =============================================================

# ---------- Endereços ----------
# Onde o site está publicado (sem barra no final). Usado para montar os
# links de retorno do pagamento e os links do e-mail.
# Hoje: GitHub Pages. Quando tiver o domínio: https://evangelhoplenoparagominas.com.br
SITE_URL=https://evangelhopleno.github.io/Conf.Mulheres_Plenas

# Endereço público deste backend (sem barra no final). Usado nos webhooks
# e nas imagens de QR Code do e-mail. Ex.: https://mulheres-plenas-api.vercel.app
API_URL=http://localhost:3000

# Origens que podem chamar a API (CORS), separadas por vírgula.
# O SITE_URL já entra automaticamente; acrescente o domínio quando existir.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

PORT=3000

# ---------- Pagamento ----------
# mock  = pagamento simulado (testes, sem cobrar ninguém)
# asaas = Asaas (Pix e cartão)
# sipag = Sipag/Sicoob (esqueleto, não homologado)
PAYMENT_PROVIDER=mock

# Asaas. A chave PRECISA combinar com a URL:
#   sandbox   https://api-sandbox.asaas.com/v3   chave $aact_hmlg_...
#   produção  https://api.asaas.com/v3           chave $aact_prod_...
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# token que você inventa e cadastra junto com o webhook no painel do Asaas;
# ele volta no cabeçalho asaas-access-token de cada notificação
ASAAS_WEBHOOK_TOKEN=

SIPAG_API_URL=https://api.sipag.com.br/v1
SIPAG_CLIENT_ID=
SIPAG_CLIENT_SECRET=
SIPAG_WEBHOOK_SECRET=

# ---------- Google Sheets ----------
# Sem planilha configurada, os pedidos ficam só na memória (somem ao reiniciar).
# Pode colar o link inteiro da planilha ou só o ID.
GOOGLE_SHEET_ID=

# Credencial da conta de serviço. No computador, basta salvar o JSON baixado
# do Google Cloud como backend/credenciais-google.json (já está no .gitignore).
# Na Vercel (sem arquivo), preencha estas duas com client_email e private_key do JSON:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---------- E-mail (Resend) ----------
# Sem a chave, o e-mail é só mostrado no console.
RESEND_API_KEY=
# Sem domínio verificado no Resend, só dá para usar onboarding@resend.dev,
# que entrega apenas para o e-mail dono da conta Resend (bom para testar).
# Com o domínio: Ingressos Conferência <ingressos@evangelhoplenoparagominas.com.br>
EMAIL_FROM=Ingressos Conferência <onboarding@resend.dev>
EMAIL_REPLY_TO=

# ---------- Administração ----------
# Senha para as rotas /api/admin (reenviar e-mail, consultar pedido).
# Gere uma longa: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
