# O deploy pela CLI envia a PASTA, não o commit — sem isto o .env e a chave do
# Google subiriam junto. As variáveis já vivem no painel da Vercel; nenhum
# segredo precisa viajar no pacote.
node_modules
.git
tmp
backend/tmp
backend/.env
backend/.env.*
!backend/.env.example
credenciais-google*.json
backend/credenciais-google*.json
*-service-account*.json
.vercel

# A raiz inteira vira site: sem isto, ESTADO.md, os runbooks, os testes e os
# scripts de manutenção ficavam abertos no domínio de venda. A função da API
# só carrega api/ e backend/src/ — nada daqui é lido em tempo de execução.
*.md
backend/test
backend/scripts
backend/.env.example
