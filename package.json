{
  "name": "conf-mulheres-plenas",
  "version": "1.0.0",
  "private": true,
  "description": "Site e backend de ingressos da Conferência Mulheres Plenas 2026",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch backend/server.js",
    "start": "node backend/server.js",
    "test": "node --test \"backend/test/**/*.test.js\"",
    "planilha:testar": "node backend/scripts/testar-planilha.js",
    "planilha:preparar": "node backend/scripts/preparar-planilha.js",
    "mercadopago:testar": "node backend/scripts/testar-mercadopago.js",
    "mercadopago:ensaio-cartao": "node backend/scripts/ensaio-cartao.js",
    "email:testar": "node backend/scripts/testar-email.js",
    "auditar": "node backend/scripts/auditar-mercadopago.js && node backend/scripts/auditar-portas.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "google-spreadsheet": "^5.3.0",
    "qrcode": "^1.5.4",
    "resend": "^6.28.1"
  }
}
